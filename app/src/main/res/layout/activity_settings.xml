<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#040B12"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.3"
            android:text="KEYS"
            android:textColor="#3FE0FF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Keys stay on this phone. Paste them here, never in a chat."
            android:textColor="#6F9AAA"
            android:textSize="14sp" />

        <TextView
            style="@style/Label"
            android:text="GOOGLE (GEMINI) API KEY" />

        <EditText
            android:id="@+id/f_gemini"
            style="@style/Field"
            android:hint="AIza..."
            tools:ignore="Autofill,LabelFor" />

        <TextView
            style="@style/Label"
            android:text="GEMINI MODEL" />

        <EditText
            android:id="@+id/f_model"
            style="@style/Field"
            android:hint="gemini-2.5-flash"
            tools:ignore="Autofill,LabelFor" />

        <TextView
            style="@style/Label"
            android:text="ELEVENLABS API KEY" />

        <EditText
            android:id="@+id/f_eleven"
            style="@style/Field"
            android:hint="sk_..."
            tools:ignore="Autofill,LabelFor" />

        <TextView
            style="@style/Label"
            android:text="ELEVENLABS VOICE ID" />

        <EditText
            android:id="@+id/f_voice"
            style="@style/Field"
            android:hint="Voice ID"
            tools:ignore="Autofill,LabelFor" />

        <TextView
            style="@style/Label"
            android:text="SPEECH LANGUAGE" />

        <EditText
            android:id="@+id/f_lang"
            style="@style/Field"
            android:hint="en-IN (use hi-IN for Hindi)"
            tools:ignore="Autofill,LabelFor" />

        <TextView
            android:id="@+id/b_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_panel"
            android:gravity="center"
            android:text="SAVE"
            android:textColor="#3FE0FF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/b_test"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:gravity="center"
            android:text="TEST VOICE"
            android:textColor="#3FE0FF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/b_access"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:gravity="center"
            android:text="OPEN ACCESSIBILITY SETTINGS"
            android:textColor="#3FE0FF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textColor="#FFB347"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
